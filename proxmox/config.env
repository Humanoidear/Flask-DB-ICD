# DataNotes Proxmox deployment settings.
# Edit this file, then run:  sudo ./create-cts.sh && sudo ./deploy.sh

# ---- network (match your Proxmox bridge) ----
BRIDGE=vmbr0
GATEWAY=10.0.0.1
CIDR=24

# ---- LXC storage and template ----
STORAGE=local-lvm
TEMPLATE=local:vztmpl/debian-12-standard_12.7-1_amd64.tar.zst

# ---- database CT ----
DB_ID=200
DB_HOST=datanotes-db
DB_IP=10.0.0.11
DB_CORES=1
DB_MEM=1024

# ---- app CT (Flask API + React frontend) ----
APP_ID=201
APP_HOST=datanotes-app
APP_IP=10.0.0.12
APP_CORES=2
APP_MEM=2048

# ---- web CT (static landing page) ----
WEB_ID=202
WEB_HOST=datanotes-web
WEB_IP=10.0.0.13
WEB_CORES=1
WEB_MEM=512

# ---- credentials (CHANGE THESE) ----
DB_NAME=datanotes
DB_USER=datanotes
DB_PASSWORD=change_me_now
CT_PASSWORD=changeme
